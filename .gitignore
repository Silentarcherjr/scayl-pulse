# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------
# SCAYL Pulse — secrets & local artifacts (do not remove)
# ---------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example

# credentials / keys / tokens
*.key
*.pem
*.p12
*.pfx
*credentials*.json
*service-account*.json
secrets/
.secrets/

# supabase local
supabase/.temp/
supabase/.branches/

# test output
/coverage
.vitest/

# editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# entregable generado: se regenera con `npm run build:pdf` al cerrar el proyecto
docs/deliverables/*.pdf

# renders temporales usados para inspección visual del PDF
/tmp/
