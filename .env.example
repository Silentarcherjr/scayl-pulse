# =============================================================================
# SCAYL Pulse — environment template
#
# Copy to .env.local and fill in. NEVER commit .env / .env.local.
# The app boots and the full demo runs with ALL of these empty:
#   - no Supabase  -> in-memory repository
#   - no Gemini    -> deterministic analyzer (clearly labelled as such)
# =============================================================================

# --- Supabase (source of truth) ----------------------------------------------
# Project Settings -> Data API.
#
# IMPORTANT: server-side persistence needs SUPABASE_SERVICE_ROLE_KEY, not the
# anon key. RLS grants anon READ access only, so a deployment with just the URL
# and the anon key would fail every write. When the service-role key is absent
# the app deliberately stays on the in-memory repository and GET /api/health
# says so. The service-role key is SERVER ONLY — never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (evidence analyzer) ----------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Admission webhook -------------------------------------------------------
# When set, hospitals must send it as `x-scayl-webhook-secret`.
# Leave empty to keep the demo open.
ADMISSION_WEBHOOK_SECRET=

# --- Local overrides (development / QA) --------------------------------------
# Force the in-memory repository even if Supabase is configured.
SCAYL_FORCE_IN_MEMORY=
# Force the deterministic analyzer even if GEMINI_API_KEY is set.
# Useful for reproducible QA runs and for demos without network access.
SCAYL_FORCE_FIXTURE_AI=
